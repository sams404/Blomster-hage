# Скопируй в .env и заполни

# AI (бесплатно)
GROQ_API_KEY=gsk_...

# Email delivery (бесплатно до 3000/мес)
RESEND_API_KEY=re_...
FROM_EMAIL=agents@blomsterhage.no
OWNER_EMAIL=samson@email.com

# Stripe (для платежей)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin
ADMIN_KEY=blomster-admin-2026

# Telegram — уведомления о сделках и отчёты
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Crocus Aurum 💰🌼 (финансовый агент) ──────────────────────
# ВАЖНО: ADMIN_KEY выше замени на свой длинный секрет — без этого
# финансовый API и приложение garden.html не откроют портфель.

# paper = виртуальные деньги на реальных ценах (по умолчанию)
# testnet = Binance testnet (настоящие ордера, фейковые деньги)
# live = реальные деньги (нужен FIN_LIVE_CONFIRM)
FIN_MODE=paper
FIN_BROKER=binance          # binance | revolut
FIN_LIVE_CONFIRM=           # для live: I_UNDERSTAND_REAL_MONEY
PAPER_START_USDT=1000

# Стратегия и лимиты риска
FIN_SYMBOLS=BTCUSDT,ETHUSDT
FIN_INTERVAL=4h
FIN_MAX_ORDER_USDT=50       # максимум на одну покупку
FIN_MAX_POSITION_PCT=25     # максимум % портфеля в одной монете
FIN_STOP_LOSS_PCT=4         # продать, если цена упала на 4% от входа
FIN_MAX_DAILY_LOSS_PCT=5    # при -5% за день — автостоп торговли
FIN_MAX_TRADES_PER_DAY=6

# Binance testnet (https://testnet.binance.vision)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# Binance live — ключ ТОЛЬКО с правами Read + Spot Trading, БЕЗ Withdraw, с IP whitelist
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Revolut X (крипто-биржа Revolut, экспериментально; pip install cryptography)
REVOLUT_X_API_KEY=
REVOLUT_X_PRIVATE_KEY_PATH=./revolut_x_private.pem
REVOLUT_X_TRADING=0         # 1 — разрешить ордера после проверки на маленькой сумме
